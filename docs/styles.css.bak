:root{
  --green:#58cc02;--green-dark:#46a302;--green-soft:#eaf8dc;--blue:#1cb0f6;--yellow:#ffc800;--orange:#ff9600;
  --red:#ff4b4b;--purple:#ce82ff;--ink:#3c3c3c;--muted:#777;--line:#e5e5e5;--soft:#f7f7f7;--white:#fff;
  --shadow:0 4px 0 rgba(0,0,0,.08);--radius:18px;
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:"Nunito",system-ui,-apple-system,sans-serif;color:var(--ink);background:#fff;font-weight:700}
button{font:inherit}.app-shell{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:255px;border-right:2px solid #eee;background:#fff;padding:24px 16px;display:flex;flex-direction:column;z-index:20}
.brand{display:flex;align-items:center;gap:12px;padding:4px 10px 24px;cursor:pointer}.brand-mark{width:44px;height:44px;border-radius:14px;background:var(--green);color:#fff;display:grid;place-items:center;font-size:28px;font-weight:900;box-shadow:0 4px 0 var(--green-dark)}.brand strong{font-size:23px;color:var(--green)}.brand span{display:block;font-size:11px;color:#999;margin-top:-2px}
.nav-list{display:flex;flex-direction:column;gap:7px}.nav-item,.sync-button{border:0;background:transparent;display:flex;align-items:center;gap:13px;padding:12px 14px;border-radius:13px;color:#666;cursor:pointer;text-align:left}.nav-item span{font-size:23px;width:28px;text-align:center}.nav-item b{flex:1}.nav-item em{font-style:normal;background:#eee;padding:2px 8px;border-radius:20px;font-size:12px}.nav-item:hover,.nav-item.active{background:#f1fbeb;color:var(--green-dark)}.nav-item.active{outline:2px solid #d8f5c8}.sidebar-bottom{margin-top:auto}.sync-button{width:100%;border:2px solid #eee;justify-content:center;margin-bottom:12px}.profile-mini{display:flex;gap:10px;align-items:center;padding:10px}.avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:#ddf4ff;color:#1687bd}.profile-mini span{display:block;color:#aaa;font-size:11px}
.main{margin-left:255px;min-height:100vh}.topbar{height:72px;border-bottom:2px solid #eee;display:flex;align-items:center;justify-content:flex-end;padding:0 5vw;position:sticky;top:0;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);z-index:15}.mobile-brand{display:none}.top-stats{display:flex;gap:8px}.stat-chip{border:0;background:transparent;border-radius:14px;padding:8px 10px;font-size:16px;cursor:pointer}.stat-chip span{font-size:20px;margin-right:5px}.stat-chip:hover{background:#f5f5f5}
.view{display:none;max-width:1120px;margin:0 auto;padding:34px 32px 90px}.view.active{display:block}.hero-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr);gap:22px}.hero-card{background:linear-gradient(135deg,#f1ffe8 0%,#fbfff7 100%);border:2px solid #dff4d2;border-radius:28px;padding:36px;position:relative;overflow:hidden}.hero-card:after{content:"🚗";position:absolute;right:28px;bottom:20px;font-size:100px;opacity:.12;transform:rotate(-6deg)}.eyebrow,.section-kicker{font-size:12px;letter-spacing:.11em;color:var(--green-dark);font-weight:900}.hero-card h1{font-size:45px;line-height:1.03;margin:8px 0 14px;letter-spacing:-.04em}.hero-card h1 span{color:var(--green)}.hero-card p{max-width:580px;color:#6e6e6e;font-size:17px;line-height:1.5}.hero-actions{display:flex;gap:10px;margin:24px 0}.btn{border:0;border-radius:14px;padding:13px 18px;text-transform:uppercase;font-size:13px;letter-spacing:.03em;font-weight:900;cursor:pointer}.btn.primary{background:var(--green);color:#fff;box-shadow:0 4px 0 var(--green-dark)}.btn.primary:active{transform:translateY(2px);box-shadow:0 2px 0 var(--green-dark)}.btn.ghost{background:#fff;border:2px solid #e6e6e6;box-shadow:0 3px 0 #e6e6e6;color:#555}.btn.dark{background:#4b4b4b;color:#fff;box-shadow:0 4px 0 #2c2c2c}.btn.small{width:100%;padding:11px}.btn.tiny{padding:8px 11px;font-size:11px}.today-line{display:flex;justify-content:space-between;margin-top:28px;font-size:13px}.progress-track{height:14px;background:#d9edd0;border-radius:30px;overflow:hidden;margin-top:7px}.progress-track i{display:block;height:100%;width:0;background:var(--green);border-radius:30px;transition:width .4s ease}
.right-stack{display:flex;flex-direction:column;gap:16px}.compact-card{border:2px solid #eee;border-radius:20px;padding:20px;background:#fff}.compact-title{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center}.compact-title>span{font-size:30px}.compact-title small,.level-card small{display:block;color:#999;font-size:11px}.compact-title b{color:var(--orange)}.week-dots{display:flex;justify-content:space-between;margin-top:16px}.week-day{display:grid;gap:5px;place-items:center;color:#aaa;font-size:10px}.week-day i{width:22px;height:22px;border-radius:50%;background:#eee;display:grid;place-items:center;font-style:normal}.week-day.done i{background:#fff2d6;color:var(--orange)}.level-card{display:flex;justify-content:space-between;align-items:center;background:#f7fbff}.level-card>div:first-child{display:flex;gap:12px;align-items:center}.level-icon{font-size:28px}.level-number{font-size:38px;color:var(--blue);font-weight:900}
.learning-section{margin-top:42px}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:15px;margin-bottom:20px}.section-head h2,.page-heading h1{margin:4px 0 0;font-size:28px}.text-button{border:0;background:transparent;color:var(--blue);font-weight:900;cursor:pointer}.path-layout{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:28px}.learning-path{padding:12px 20px 40px;position:relative}.learning-path:before{content:"";position:absolute;left:56px;top:38px;bottom:60px;width:8px;background:#ededed;border-radius:20px}.path-node{display:grid;grid-template-columns:72px 1fr;gap:18px;align-items:center;margin:14px 0;position:relative}.node-bubble{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;font-size:29px;background:#fff;border:6px solid #ddd;box-shadow:0 5px 0 #cfcfcf;z-index:2;cursor:pointer}.path-node.done .node-bubble{border-color:var(--green);background:#f1ffe7;box-shadow:0 5px 0 var(--green-dark)}.path-node.current .node-bubble{border-color:var(--blue);background:#eaf8ff;box-shadow:0 5px 0 #1687bd;animation:pulse 2s infinite}.path-node.locked{opacity:.55}.node-content{border:2px solid #eee;border-radius:17px;padding:15px 18px;cursor:pointer;background:#fff}.node-content:hover{border-color:#d4d4d4}.node-content small{color:#aaa}.node-content h3{margin:3px 0 4px;font-size:16px}.node-content p{margin:0;color:#888;font-size:12px}.node-progress{height:7px;background:#eee;border-radius:20px;margin-top:8px;overflow:hidden}.node-progress i{display:block;height:100%;background:var(--green);border-radius:20px}.path-side{display:flex;flex-direction:column;gap:16px}.side-card{border:2px solid #eee;border-radius:20px;padding:20px;text-align:center}.side-emoji{font-size:40px}.side-card h3{margin:8px 0 4px}.side-card p{font-size:12px;color:#888;line-height:1.4}.zero-card{background:#f7fff2}.test-card{background:#fafafa}@keyframes pulse{0%,100%{box-shadow:0 5px 0 #1687bd,0 0 0 0 rgba(28,176,246,.15)}50%{box-shadow:0 5px 0 #1687bd,0 0 0 12px rgba(28,176,246,0)}}
.page-heading{margin-bottom:26px}.page-heading p{color:#888;margin:7px 0}.topics-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.topic-card{border:2px solid #eee;border-radius:20px;padding:20px;background:#fff;cursor:pointer;transition:.18s}.topic-card:hover{transform:translateY(-2px);border-color:#d6d6d6;box-shadow:var(--shadow)}.topic-head{display:flex;justify-content:space-between;gap:15px}.topic-icon{font-size:34px}.topic-number{color:#aaa;font-size:12px}.topic-card h3{margin:11px 0 5px}.topic-card p{color:#888;font-size:12px;min-height:34px}.topic-actions{display:flex;gap:8px;margin-top:14px}.topic-actions button{border:0;border-radius:10px;padding:8px 10px;background:#f4f4f4;cursor:pointer;font-size:11px;font-weight:900}.topic-actions button:first-child{background:var(--green-soft);color:var(--green-dark)}
.simulator-toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.filter-pill{border:2px solid #eee;border-radius:30px;padding:7px 13px;color:#888;font-size:12px}.filter-pill.active{border-color:#bce5ff;background:#eef9ff;color:#1687bd}.sim-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.sim-card{border:2px solid #eee;border-radius:17px;padding:15px;cursor:pointer;background:#fff}.sim-card:hover{border-color:#ccc}.sim-card .sim-top{display:flex;justify-content:space-between}.sim-card strong{font-size:14px}.sim-card small{color:#aaa}.sim-score{font-size:22px;margin:14px 0 5px}.sim-status{font-size:11px;color:#888}.sim-card.approved{border-color:#ccefb6;background:#fbfff8}.sim-card.failed{border-color:#ffd0d0;background:#fffafa}
.mistake-summary{display:flex;justify-content:space-between;align-items:center;border:2px solid #eee;border-radius:22px;padding:22px;margin-bottom:20px}.mistake-summary>div{display:flex;align-items:baseline;gap:10px}.mistake-summary strong{font-size:40px;color:var(--red)}.mistake-summary span{color:#888}.empty-state{border:2px dashed #ddd;border-radius:20px;text-align:center;padding:50px;color:#888}.empty-state>span{font-size:48px}.empty-state h3{color:#555}.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:20px}.metric-card{border:2px solid #eee;border-radius:18px;padding:18px;display:flex;align-items:center;gap:12px}.metric-card>span{font-size:28px}.metric-card small{display:block;color:#aaa;font-size:10px}.metric-card strong{font-size:22px}.progress-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}.panel{border:2px solid #eee;border-radius:20px;padding:20px}.panel h3{margin-top:0}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px}.topic-progress-row{margin:14px 0}.topic-progress-row>div:first-child{display:flex;justify-content:space-between;font-size:12px}.mini-track{height:8px;background:#eee;border-radius:20px;margin-top:6px;overflow:hidden}.mini-track i{display:block;height:100%;background:var(--green);border-radius:20px}.diag-row{display:grid;grid-template-columns:100px 1fr;gap:10px;padding:9px 0;border-bottom:1px solid #eee;font-size:12px}.diag-row:last-child{border:0}.diag-row span{color:#999}.diag-ok{color:var(--green-dark)}.diag-warn{color:var(--orange)}
.mobile-nav{display:none}.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:99;display:grid;place-items:center;padding:20px}.modal-backdrop[hidden]{display:none}.modal{width:min(680px,100%);max-height:min(82vh,760px);overflow:auto;background:#fff;border-radius:24px;padding:28px;position:relative;box-shadow:0 24px 70px rgba(0,0,0,.25)}.modal-close{position:absolute;right:17px;top:13px;border:0;background:#f2f2f2;width:36px;height:36px;border-radius:50%;font-size:22px;cursor:pointer}.modal h2{margin:4px 45px 5px 0}.lesson-slide{min-height:280px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:30px 16px}.lesson-slide .big{font-size:72px}.lesson-slide p{font-size:19px;line-height:1.5;max-width:500px;color:#666}.lesson-tip{background:#fff7d6;border:2px solid #ffe37e;border-radius:16px;padding:12px 15px;margin-top:12px}.slide-controls{display:flex;justify-content:space-between;gap:10px}.slide-dots{display:flex;justify-content:center;gap:7px;margin:14px}.slide-dots i{width:9px;height:9px;background:#ddd;border-radius:50%}.slide-dots i.active{background:var(--green)}
@media (max-width:1050px){.sidebar{width:88px;padding:20px 12px}.brand{padding-left:10px}.brand>div:last-child,.nav-item b,.nav-item em,.sidebar-bottom span,.profile-mini>div:last-child{display:none}.nav-item{justify-content:center}.sidebar-bottom .sync-button{font-size:20px}.profile-mini{justify-content:center}.main{margin-left:88px}.topics-grid{grid-template-columns:repeat(2,1fr)}.sim-grid{grid-template-columns:repeat(3,1fr)}}
@media (max-width:780px){.sidebar{display:none}.main{margin-left:0}.topbar{height:64px;justify-content:space-between;padding:0 16px}.mobile-brand{display:flex;gap:9px;align-items:center}.mobile-brand .brand-mark{width:34px;height:34px;border-radius:10px;font-size:21px}.view{padding:24px 16px 105px}.hero-grid,.path-layout,.progress-grid{grid-template-columns:1fr}.hero-card{padding:28px 22px}.hero-card h1{font-size:36px}.hero-card:after{font-size:75px}.right-stack{display:grid;grid-template-columns:1fr 1fr}.path-side{display:grid;grid-template-columns:1fr 1fr}.topics-grid{grid-template-columns:1fr 1fr}.sim-grid{grid-template-columns:repeat(2,1fr)}.stats-grid{grid-template-columns:1fr 1fr}.mobile-nav{position:fixed;left:0;right:0;bottom:0;height:72px;background:#fff;border-top:2px solid #eee;display:grid;grid-template-columns:repeat(5,1fr);z-index:30;padding-bottom:env(safe-area-inset-bottom)}.mobile-nav button{border:0;background:#fff;display:grid;place-items:center;font-size:19px;color:#999}.mobile-nav span{font-size:9px;margin-top:-8px}.mobile-nav button.active{color:var(--green-dark);background:#f8fff4}.section-head{align-items:flex-start}.text-button{font-size:12px}.learning-path{padding-left:4px;padding-right:4px}}
@media (max-width:520px){.top-stats .stat-chip:nth-child(3){display:none}.hero-actions{flex-direction:column}.right-stack,.path-side,.topics-grid{grid-template-columns:1fr}.sim-grid{grid-template-columns:1fr}.compact-card{padding:15px}.section-head{display:block}.section-head .text-button{margin-top:8px}.path-node{grid-template-columns:64px 1fr}.node-bubble{width:62px;height:62px}.learning-path:before{left:31px}.stats-grid{grid-template-columns:1fr}.mistake-summary{align-items:flex-start;gap:16px;flex-direction:column}.mistake-summary .btn{width:100%}}
.bank-count{display:block;color:#aaa;font-size:10px;margin-top:6px}.mistake-row{display:grid;grid-template-columns:32px 1fr auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid #eee}.mistake-row:last-child{border:0}.mistake-row>span{color:#aaa}.mistake-row b{display:block;font-size:12px}.mistake-row small{display:block;color:#aaa;margin-top:3px}.mistake-row button{border:2px solid #eee;background:#fff;border-radius:10px;padding:7px 10px;cursor:pointer;color:#1687bd}.quiz-shell{padding-top:4px}.quiz-header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.quiz-header>b{color:#999;white-space:nowrap}.quiz-progress{height:10px;background:#eee;border-radius:20px;overflow:hidden;margin:14px 0 18px}.quiz-progress i{display:block;height:100%;background:var(--green);border-radius:20px}.question-image-wrap{display:flex;justify-content:center;margin:8px 0 14px;background:#f7f7f7;border-radius:18px;padding:10px;min-height:120px}.question-image{max-width:100%;max-height:320px;object-fit:contain;border-radius:12px}.question-meta{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}.question-meta span{font-size:10px;color:#888;background:#f4f4f4;border-radius:20px;padding:5px 9px}.question-text{font-size:20px;line-height:1.35;margin:10px 0 16px}.answer-list{display:grid;gap:10px}.answer-option{width:100%;border:2px solid #ddd;border-bottom-width:4px;background:#fff;border-radius:15px;padding:12px 14px;display:grid;grid-template-columns:38px 1fr;gap:10px;align-items:center;text-align:left;cursor:pointer;color:var(--ink)}.answer-option>span{width:32px;height:32px;border:2px solid #ddd;border-radius:9px;display:grid;place-items:center}.answer-option>b{font-size:14px;line-height:1.35}.answer-option:hover:not(:disabled),.answer-option.selected{border-color:var(--blue);background:#f1fbff}.answer-option.selected>span{border-color:var(--blue);color:#1687bd}.answer-option.correct{border-color:var(--green);background:#f5ffed}.answer-option.wrong{border-color:var(--red);background:#fff3f3}.answer-option:disabled{cursor:default}.answer-feedback{margin:14px 0;border-radius:16px;padding:14px 16px}.answer-feedback.ok{background:#f1ffe8;border:2px solid #bce69b}.answer-feedback.bad{background:#fff1f1;border:2px solid #ffc1c1}.answer-feedback strong{font-size:15px}.answer-feedback p{margin:7px 0;font-size:13px;line-height:1.45;font-weight:700}.answer-feedback small{display:block;margin-top:7px}.quiz-footer{display:flex;justify-content:space-between;gap:12px;margin-top:18px}.quiz-footer .btn{min-width:130px}.result-card{text-align:center;padding:34px 12px 20px}.result-emoji{font-size:65px}.result-card h2{margin-right:0}.result-score{font-size:62px;color:var(--green);font-weight:900;margin:8px 0}.result-score small{font-size:24px;color:#aaa}.result-card p{font-size:17px;color:#666}.result-actions{display:flex;justify-content:center;gap:10px;margin-top:20px;flex-wrap:wrap}@media(max-width:520px){.modal{padding:20px 14px}.question-text{font-size:17px}.question-image{max-height:230px}.answer-option{grid-template-columns:34px 1fr;padding:10px}.answer-option>b{font-size:13px}.quiz-footer{position:sticky;bottom:-20px;background:#fff;padding:12px 0 4px}.mistake-row{grid-template-columns:28px 1fr}.mistake-row button{grid-column:2}.question-meta span{font-size:9px}}

/* v10 · práctica completa por temas */
.bank-count b{color:var(--ink);font-size:12px}.topic-actions .practice{background:#eaf7ff!important;color:#1687bd!important}.practice-menu{padding:8px 4px 4px}.practice-menu>p{color:#777;line-height:1.45}.practice-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:20px 0}.practice-stats>div{background:#f7f7f7;border:2px solid #eee;border-radius:16px;text-align:center;padding:14px 8px}.practice-stats b{display:block;font-size:24px}.practice-stats span{display:block;color:#888;font-size:11px;margin-top:2px}.practice-note,.cycle-complete{border-radius:14px;padding:12px 14px;margin:12px 0 18px;font-size:13px;font-weight:700}.practice-note{background:#f4f9ff;border:2px solid #dceeff}.cycle-complete{background:#f1ffe8;border:2px solid #bce69b}.practice-options{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.practice-options button,.custom-count button{border:2px solid #dfe6e9;border-bottom-width:4px;background:#fff;border-radius:14px;padding:13px 10px;font-weight:900;cursor:pointer;color:var(--ink)}.practice-options button:hover,.custom-count button:hover{border-color:var(--green);background:var(--green-soft)}.practice-options .wide{grid-column:1/-1;background:var(--green);border-color:var(--green-dark);color:#fff}.custom-count{margin-top:18px}.custom-count label{display:block;font-size:12px;font-weight:900;margin-bottom:7px}.custom-count>div{display:grid;grid-template-columns:1fr auto;gap:8px}.custom-count input{border:2px solid #ddd;border-radius:13px;padding:12px 14px;font:inherit;font-weight:800;min-width:0}.topic-mistakes{width:100%;margin-top:14px}.topic-progress-row small{color:#aaa;font-size:10px;font-weight:700}@media(max-width:520px){.practice-stats{grid-template-columns:repeat(2,1fr)}.practice-options{grid-template-columns:1fr 1fr}.practice-options .wide{grid-column:1/-1}.custom-count>div{grid-template-columns:1fr}.custom-count button{width:100%}}


/* v11 · temario visual completo + 18 temas exactos */
.study-lesson{padding:4px}.study-top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.study-count{background:#f3f3f3;border-radius:999px;padding:7px 11px;color:#888;font-size:12px}.study-progress{height:8px;background:#eee;border-radius:999px;overflow:hidden;margin:16px 0}.study-progress i{display:block;height:100%;background:var(--green);border-radius:999px}.memory-card{border:2px solid #e5e5e5;border-bottom-width:5px;border-radius:24px;padding:30px 26px;text-align:center;background:linear-gradient(180deg,#fff,#fbfff8)}.memory-icon{font-size:58px;display:block;margin-bottom:8px}.memory-card h3{font-size:27px;margin:4px 0 10px}.memory-card p{font-size:18px;line-height:1.5;color:#626262;max-width:560px;margin:0 auto}.memory-hook{margin:22px auto 0;max-width:530px;text-align:left;background:#fff7d7;border:2px solid #ffe174;border-radius:16px;padding:13px 15px}.memory-hook b{display:block;color:#b17a00;font-size:11px;margin-bottom:4px}.memory-hook span{font-size:15px;line-height:1.35}.study-extra{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.study-extra .btn{white-space:normal}.study-extra small{display:block;font-size:9px;color:#999;margin-top:2px}.manual-gallery>p{color:#777;line-height:1.5}.manual-page-list{display:grid;gap:18px;margin-top:18px}.manual-page-list figure{margin:0;border:2px solid #e7e7e7;border-radius:18px;overflow:hidden;background:#f6f6f6}.manual-page-list img{display:block;width:100%;height:auto}.manual-page-list figcaption{text-align:center;padding:8px;color:#999;font-size:11px}.manual-actions{position:sticky;bottom:-28px;background:#fff;padding:13px 0 3px;display:flex;justify-content:space-between;gap:10px}.topic-card .lesson:before{content:"🧠 ";}.topic-card .lesson{background:#f5edff!important;color:#7b42ad!important}.topic-card .bank-count{line-height:1.35}.modal{max-height:90vh}
@media(max-width:520px){.memory-card{padding:24px 15px}.memory-card h3{font-size:22px}.memory-card p{font-size:16px}.study-extra{grid-template-columns:1fr}.manual-actions{flex-direction:column}.manual-actions .btn{width:100%}.study-top h2{font-size:20px}}
